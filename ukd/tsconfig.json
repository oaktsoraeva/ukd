{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "paths": {
      // Файлы кита лежат вне ukd/, и react для них иначе не разрешается:
      // своего node_modules у design-system в этой репе нет
      "react": ["./node_modules/@types/react"],
      "react/*": ["./node_modules/@types/react/*"],
      "react-dom": ["./node_modules/@types/react-dom"],
      "@ds": ["../design-system/src/index.ts"],
      "@ds/icons": ["../design-system/src/icons.ts"],
      "@ds/*": ["../design-system/src/*"]
    }
  },
  "include": ["src"]
}
